<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Info.plist — Application Apple Watch « Forbach en Rose ».

  ⚠️ WKApplication ET NON WKWatchKitApp. Depuis Xcode 14, une application de
  montre est une cible unique, sans extension. Avec l'ancienne clé, la montre
  se construit puis refuse de se lancer, sans message exploitable.

  ⚠️ WKCompanionAppBundleIdentifier DOIT ÊTRE EXACTEMENT l'identifiant de
  l'iPhone, et celui de la montre exactement le même suivi de « .watchkitapp ».
  Sans cette correspondance, les deux applications ne se reconnaissent pas :
  WatchConnectivity ne transmet rien et la montre reste bloquée sur « Ouvrez
  l'application sur votre iPhone », sans qu'aucune erreur n'apparaisse nulle
  part.
-->
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Forbach en Rose</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>WKApplication</key>
	<true/>
	<key>WKCompanionAppBundleIdentifier</key>
	<string>fr.forbachenrose.ferIos</string>
	<key>WKRunsIndependentlyOfCompanionApp</key>
	<false/>
</dict>
</plist>
