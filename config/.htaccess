# Bloquer l'accès à tous les fichiers cachés (.env, .htaccess, etc.)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Bloquer aussi les fichiers sensibles par extension
# 🔒 [SEC-03] .json ajouté pour protéger token.json (CWE-538)
# 🔒 v2.0.0 : .enc et .key ajoutés pour protéger config.enc et master.key
<FilesMatch "\.(env|log|bak|sql|old|txt|json|enc|key)$">
    Require all denied
</FilesMatch>